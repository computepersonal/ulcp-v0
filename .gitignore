# Dependencies
node_modules/
.pnpm-store/

# Environment files (NEVER commit secrets)
.env
.env.local
.env.*.local
.env.production

# Build outputs
dist/
build/
out/

# Turbo cache
.turbo/

# Prisma generated clients (per-service output dirs)
services/*/src/generated/
packages/*/src/generated/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.idea/
*.swp
*.swo

# Uploads / media
uploads/
tmp/

# Screenshots
screenshots/

# TypeScript incremental build info
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Docker local data volumes
pgdata/
redis-data/
