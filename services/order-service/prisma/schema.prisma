generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id          String  @id @default(cuid())
  tenant_id   String
  branch_id   String
  table_id    String?
  session_id  String?
  customer_id String?

  order_number String // ORD-001, sequential per branch per day
  type         String  @default("dine_in") // dine_in | takeaway | delivery
  status       String  @default("pending") // pending | confirmed | preparing | ready | picked_up | delivered | completed | cancelled

  // Snapshot of items at time of order
  // Each item: { id, name, price, quantity, veg_type, gst_rate, is_tax_inclusive, station, variant_name?, options?, addons? }
  items Json @default("[]")

  // Amounts in paise
  subtotal        Int @default(0)
  tax_amount      Int @default(0)
  discount_amount Int @default(0)
  tip_amount      Int @default(0)
  total           Int @default(0)

  // GST breakdown: { cgst: Int, sgst: Int, igst: Int }
  gst_breakdown Json?

  payment_status String  @default("pending") // pending | paid | failed | refunded
  payment_method String? // cash | upi | card | online

  notes            String?
  cancelled_reason String?
  cancelled_by     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  kots           KOT[]
  status_history OrderStatusHistory[]
  commission     CommissionRecord?

  @@index([tenant_id])
  @@index([branch_id])
  @@index([status])
  @@index([created_at])
  @@map("orders")
}

// ─── KOT (Kitchen Order Ticket) ───────────────────────────────────────────────

model KOT {
  id        String @id @default(cuid())
  tenant_id String
  branch_id String
  order_id  String

  kot_number String @default("KOT-001") // KOT-001, sequential per branch per day
  station    String @default("kitchen") // kitchen | bar
  status     String @default("pending") // pending | acknowledged | preparing | ready | served | rejected

  // Items for this station (snapshot from order items filtered by station)
  // Each item: { id, name, price, quantity, variant_name?, options?, addons?, status? }
  items Json @default("[]")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([branch_id])
  @@index([order_id])
  @@index([status])
  @@map("kots")
}

// ─── Order Status History ─────────────────────────────────────────────────────

model OrderStatusHistory {
  id         String   @id @default(cuid())
  order_id   String
  status     String
  changed_by String?
  notes      String?
  created_at DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_status_history")
}

// ─── Commission Records ───────────────────────────────────────────────────────

model CommissionRecord {
  id        String @id @default(cuid())
  order_id  String @unique
  tenant_id String
  rate      Float // percentage e.g. 3.0
  amount    Int // in paise
  plan      String // free | starter | pro
  settled   Boolean  @default(false)

  created_at DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([settled])
  @@map("commission_records")
}

// ─── Daily Counters ───────────────────────────────────────────────────────────
// Tracks sequential order_number and kot_number per branch per day.
// Counter auto-resets by using date string as part of the unique key.

model DailyCounter {
  id        String @id @default(cuid())
  branch_id String
  date      String // "2026-03-28"
  order_seq Int    @default(0)
  kot_seq   Int    @default(0)

  @@unique([branch_id, date])
  @@map("daily_counters")
}
