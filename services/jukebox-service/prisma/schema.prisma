generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JukeboxStatus {
  queued
  playing
  played
  skipped
}

model JukeboxConfig {
  id                  String    @id @default(cuid())
  tenant_id           String    @unique
  branch_id           String
  is_enabled          Boolean   @default(false)
  price_per_song      Int       @default(2000)
  max_queue_length    Int       @default(20)
  max_songs_per_user  Int       @default(3)
  allow_dedications   Boolean   @default(true)
  content_filter      String    @default("family")
  player_setup_code   String?
  player_token        String?
  player_last_seen    DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@map("jukebox_configs")
}

model JukeboxQueue {
  id                       String        @id @default(cuid())
  tenant_id                String
  branch_id                String
  position                 Int
  status                   JukeboxStatus @default(queued)
  song_id                  String
  song_title               String
  song_artist              String
  song_duration_secs       Int
  song_thumbnail           String
  source                   String        @default("youtube")
  requested_by_alias       String
  requested_by_customer_id String?
  dedicated_to_alias       String?
  dedication_message       String?
  order_id                 String?
  amount_charged           Int
  played_at                DateTime?
  skipped_at               DateTime?
  created_at               DateTime      @default(now())

  @@index([tenant_id, branch_id, status])
  @@map("jukebox_queue")
}

model JukeboxHistory {
  id             String   @id @default(cuid())
  tenant_id      String
  branch_id      String
  song_title     String
  song_artist    String
  song_thumbnail String
  requested_by   String
  dedicated_to   String?
  played_at      DateTime
  duration_secs  Int

  @@index([tenant_id, branch_id])
  @@map("jukebox_history")
}
