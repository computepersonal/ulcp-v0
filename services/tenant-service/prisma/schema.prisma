generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenants ──────────────────────────────────────────────────────────────────

model Tenant {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  business_type String
  // self_service_cafe | seated_food_only | seated_full_service | seated_self_order |
  // home_kitchen | cloud_kitchen | restaurant_plus_delivery | catering | food_truck |
  // gated_community | kirana | boutique | nursery | pharmacy | handicrafts |
  // bakery | stationery | custom
  plan         String  @default("free") // free | premium | allinone
  active_addons String[] @default([])   // add-on IDs: social_jukebox, inventory_procurement, customer_crm, advertising
  country      String  @default("IN")
  currency     String  @default("INR")
  timezone     String  @default("Asia/Kolkata")
  is_active    Boolean @default(true)
  is_chain     Boolean @default(false)
  chain_config Json?   // { sharedCatalogue, allowBranchPricing, unifiedLoyalty }

  gst_registered   Boolean @default(false)
  gstin            String?
  gst_state_code   String?
  gst_default_rate Int     @default(0)

  logo_url  String?
  cover_url String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  phone     String?
  email     String?
  website   String?

  owner_user_id String // references identity-service user.id (cross-service, no FK)

  // KOT acknowledgment mode — how kitchen acknowledges a new KOT
  // "auto"    → auto-ack after kot_ack_delay_secs (default for free plan)
  // "kds"     → manual tap on KDS screen (default for premium+)
  // "printer" → auto-ack on successful thermal print job
  kot_ack_mode       String @default("auto") // auto | kds | printer
  kot_ack_delay_secs Int    @default(60)     // seconds before auto-ack (mode=auto only)

  onboarding_step      Int      @default(1)
  onboarding_completed Boolean  @default(false)
  setup_tasks          Json?    // { catalogue: bool, tables: bool, staff: bool, qr: bool } — post-onboarding checklist (server-persisted)
  free_trial_used      Boolean   @default(false) // true once free trial has been consumed — one-time per tenant lifetime
  trial_ends_at        DateTime? // free plan: 1 month from signup, null if no trial granted

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  branches       Branch[]
  partners       Partner[]
  staff_invites  StaffInvite[]
  staff_profiles StaffProfile[]
  subscriptions  Subscription[]
  kds_setup_codes KdsSetupCode[]

  @@index([slug])
  @@index([owner_user_id])
  @@map("tenants")
}

// ─── Branches ─────────────────────────────────────────────────────────────────

model Branch {
  id         String  @id @default(cuid())
  tenant_id  String
  name       String
  address    String?
  phone      String?
  is_active  Boolean @default(true)
  is_primary Boolean @default(false)
  lat        Float?
  lng        Float?
  timezone   String  @default("Asia/Kolkata")
  printer_ip String?
  delivery_radius_km Float @default(5)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant          Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  tables          Table[]
  sections        Section[]
  kds_setup_codes KdsSetupCode[]
  reservations    Reservation[]

  @@index([tenant_id])
  @@map("branches")
}

// ─── Partners ─────────────────────────────────────────────────────────────────

model Partner {
  id                String    @id @default(cuid())
  tenant_id         String
  user_id           String    // identity-service user.id
  role              String
  // managing_partner | silent_partner | operations_partner | branch_partner | custom_partner
  permissions       Json      @default("{}")
  assigned_branches String[]  @default([])
  invited_by        String    // user_id of inviter
  invite_token      String?   @unique
  invite_expires_at DateTime?
  accepted_at       DateTime?
  is_active         Boolean   @default(false) // false until invite accepted

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([user_id])
  @@map("partners")
}

// ─── Staff Invites ────────────────────────────────────────────────────────────

model StaffInvite {
  id           String    @id @default(cuid())
  tenant_id    String
  branch_id    String?
  email        String
  role         String
  permissions  String[]  @default([])
  invited_by   String    // user_id
  invite_token String    @unique
  expires_at   DateTime
  accepted_at  DateTime?

  created_at DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([email])
  @@map("staff_invites")
}

// ─── Staff Profiles ──────────────────────────────────────────────────────────
// Profile data for staff members. user_id references identity-service User (cross-service, no FK).

model StaffProfile {
  id         String  @id @default(cuid())
  tenant_id  String
  user_id    String  @unique // identity-service User.id — one profile per user
  branch_id  String?

  // Personal
  phone             String?
  alt_phone         String?
  date_of_birth     DateTime?
  gender            String?   // male | female | other | prefer_not_to_say
  photo_url         String?
  address_line1     String?
  address_line2     String?
  city              String?
  state             String?
  pincode           String?

  // Emergency contact
  emergency_name    String?
  emergency_phone   String?
  emergency_relation String?

  // Employment
  joining_date      DateTime?
  department        String?   // kitchen | service | management | delivery | other
  designation       String?   // custom title e.g. "Senior Chef", "Floor Manager"
  employment_type   String    @default("full_time") // full_time | part_time | contract | intern
  bank_account_no   String?
  bank_ifsc         String?
  bank_name         String?
  pan_number        String?
  aadhaar_last4     String?   // only last 4 digits stored for verification display

  // Documents (URLs)
  id_proof_url      String?
  address_proof_url String?

  notes             String?   // internal notes about staff member

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([branch_id])
  @@map("staff_profiles")
}

// ─── Staff Wages ─────────────────────────────────────────────────────────────

model StaffWage {
  id          String  @id @default(cuid())
  tenant_id   String
  user_id     String  // identity-service User.id
  wage_type   String  @default("monthly") // monthly | hourly | daily | per_shift
  amount      Int     // in paise/cents (integer only)
  currency    String  @default("INR")
  effective_from DateTime
  effective_to   DateTime? // null = current/open-ended
  notes       String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id])
  @@index([user_id])
  @@map("staff_wages")
}

// ─── Shift Templates ─────────────────────────────────────────────────────────

model ShiftTemplate {
  id         String  @id @default(cuid())
  tenant_id  String
  branch_id  String?
  name       String  // e.g. "Morning Shift", "Evening Shift", "Night Shift"
  start_time String  // HH:mm format (e.g. "09:00")
  end_time   String  // HH:mm format (e.g. "17:00")
  break_mins Int     @default(0)
  color      String  @default("#6366F1") // for calendar display
  is_active  Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shift_assignments ShiftAssignment[]

  @@index([tenant_id])
  @@map("shift_templates")
}

// ─── Shift Assignments (Schedule) ────────────────────────────────────────────

model ShiftAssignment {
  id           String   @id @default(cuid())
  tenant_id    String
  user_id      String   // identity-service User.id
  branch_id    String?
  shift_id     String   // ShiftTemplate.id
  date         DateTime // the specific date (YYYY-MM-DD stored as midnight UTC)
  status       String   @default("scheduled") // scheduled | completed | missed | swapped
  notes        String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shift ShiftTemplate @relation(fields: [shift_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date, shift_id])
  @@index([tenant_id])
  @@index([user_id, date])
  @@index([date])
  @@map("shift_assignments")
}

// ─── Attendance ──────────────────────────────────────────────────────────────

model Attendance {
  id          String    @id @default(cuid())
  tenant_id   String
  user_id     String    // identity-service User.id
  branch_id   String?
  date        DateTime  // the date (YYYY-MM-DD stored as midnight UTC)
  clock_in    DateTime?
  clock_out   DateTime?
  clock_in_method  String? // app_pin | gps | manual
  clock_out_method String?
  hours_worked     Float?  // computed on clock_out
  overtime_mins    Int     @default(0)
  late_by_mins     Int     @default(0)
  status      String    @default("absent") // present | absent | half_day | on_leave | holiday
  notes       String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, date])
  @@index([tenant_id])
  @@index([user_id, date])
  @@map("attendance")
}

// ─── Leave Types ─────────────────────────────────────────────────────────────

model LeaveType {
  id          String  @id @default(cuid())
  tenant_id   String
  name        String  // e.g. "Casual Leave", "Sick Leave", "Earned Leave"
  code        String  // e.g. "CL", "SL", "EL"
  annual_quota Int    @default(12) // days per year
  is_paid     Boolean @default(true)
  carry_forward Boolean @default(false)
  max_carry    Int     @default(0)
  is_active   Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_balances LeaveBalance[]
  leave_requests LeaveRequest[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@map("leave_types")
}

// ─── Leave Balances ──────────────────────────────────────────────────────────

model LeaveBalance {
  id          String  @id @default(cuid())
  tenant_id   String
  user_id     String  // identity-service User.id
  leave_type_id String
  year        Int     // e.g. 2026
  total       Int     // annual quota (may include carry forward)
  used        Int     @default(0)
  pending     Int     @default(0) // pending approval

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_type LeaveType @relation(fields: [leave_type_id], references: [id], onDelete: Cascade)

  @@unique([user_id, leave_type_id, year])
  @@index([tenant_id])
  @@index([user_id, year])
  @@map("leave_balances")
}

// ─── Leave Requests ──────────────────────────────────────────────────────────

model LeaveRequest {
  id           String   @id @default(cuid())
  tenant_id    String
  user_id      String   // identity-service User.id (requester)
  leave_type_id String
  start_date   DateTime
  end_date     DateTime
  days         Float    // 0.5 for half day, 1, 2, etc.
  reason       String?
  status       String   @default("pending") // pending | approved | rejected | cancelled
  reviewed_by  String?  // user_id of approver
  reviewed_at  DateTime?
  review_notes String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  leave_type LeaveType @relation(fields: [leave_type_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([user_id])
  @@index([status])
  @@map("leave_requests")
}

// ─── Sections ─────────────────────────────────────────────────────────────────

model Section {
  id        String  @id @default(cuid())
  tenant_id String
  branch_id String
  name      String  // e.g. "Rooftop", "Lakeside", "Indoor"
  color     String  @default("#6366F1") // hex color for floor map
  position  Int     @default(0)
  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  branch Branch  @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  tables Table[]

  @@index([tenant_id])
  @@index([branch_id])
  @@map("sections")
}

// ─── Tables ───────────────────────────────────────────────────────────────────

model Table {
  id         String  @id @default(cuid())
  tenant_id  String
  branch_id  String
  section_id String?
  name       String
  capacity   Int     @default(2)
  qr_code    String
  is_active  Boolean @default(true)
  position   Int     @default(0)
  status     String  @default("available")
  // available | pending_confirmation | occupied | billed

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  branch       Branch         @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  section      Section?       @relation(fields: [section_id], references: [id], onDelete: SetNull)
  sessions     TableSession[]
  reservations Reservation[]

  @@index([tenant_id])
  @@index([branch_id])
  @@map("tables")
}

// ─── Table Sessions ───────────────────────────────────────────────────────────

model TableSession {
  id             String    @id @default(cuid())
  tenant_id      String
  branch_id      String
  table_id       String
  customer_id    String?
  customer_phone String?
  customer_name  String?
  pax            Int       @default(1)

  status         String    @default("pending_confirmation")
  // pending_confirmation | open | billed | closed

  confirmed_at   DateTime?
  confirmed_by   String?   // staff user_id; null = auto-confirmed

  opened_at      DateTime  @default(now())
  closed_at      DateTime?

  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  table Table @relation(fields: [table_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([branch_id])
  @@index([table_id])
  @@index([status])
  @@map("table_sessions")
}

// ─── Subscriptions ────────────────────────────────────────────────────────────

model Subscription {
  id                       String    @id @default(cuid())
  tenant_id                String
  plan                     String    // free | premium | allinone
  type                     String    @default("plan") // "plan" | "addon"
  addon_id                 String?   // set when type="addon" — e.g. "social_jukebox"
  started_at               DateTime  @default(now())
  expires_at               DateTime?
  razorpay_subscription_id String?
  is_active                Boolean   @default(true)
  amount                   Int       @default(0) // monthly charge in paise

  created_at DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@map("subscriptions")
}

// ─── Reservations ─────────────────────────────────────────────────────────────

model Reservation {
  id              String    @id @default(cuid())
  tenant_id       String
  branch_id       String
  table_id        String?   // optional — can reserve without assigning a table yet

  customer_name   String
  customer_phone  String
  customer_email  String?
  pax             Int       @default(2)

  date            String    // "YYYY-MM-DD"
  time_slot       String    // "HH:MM" (24h)

  status          String    @default("pending")
  // pending | confirmed | seated | cancelled | no_show

  notes           String?
  created_by      String?   // staff user_id

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  branch Branch  @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  table  Table?  @relation(fields: [table_id],  references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([branch_id])
  @@index([date])
  @@index([status])
  @@map("reservations")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────
// Tracks all significant staff actions across tables, sections, and other entities.

model AuditLog {
  id          String @id @default(cuid())
  tenant_id   String
  branch_id   String?

  actor_id    String  // user_id from JWT
  actor_name  String? // display name snapshot (from JWT name field)
  actor_role  String  // role snapshot at time of action

  action      String
  // table.created | table.deleted | table.capacity_changed | table.zone_changed | table.renamed
  // section.created | section.deleted | section.renamed
  // reservation.created | reservation.confirmed | reservation.cancelled

  entity_type String  // table | section | reservation | session
  entity_id   String  // cuid of the affected entity
  entity_name String  // name snapshot at time of action

  metadata    Json?   // before/after values, context (e.g. old zone → new zone)

  created_at  DateTime @default(now())

  @@index([tenant_id])
  @@index([branch_id])
  @@index([actor_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

// ─── KDS Setup Codes ──────────────────────────────────────────────────────────

model KdsSetupCode {
  id         String    @id @default(cuid())
  code       String    @unique
  tenant_id  String
  branch_id  String
  station    String    // kitchen | bar
  expires_at DateTime
  used_at    DateTime?

  created_at DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([code])
  @@map("kds_setup_codes")
}
