generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Ingredient ────────────────────────────────────────────────────────────────

model Ingredient {
  id        String   @id @default(cuid())
  tenant_id String
  branch_id String

  name     String
  category String   // e.g. "dairy", "produce", "spice", "packaging"
  unit     String   // kg, g, ml, l, pcs, etc.

  current_stock    Float @default(0)
  minimum_stock    Float @default(0)   // LOW alert threshold
  critical_stock   Float @default(0)   // CRITICAL alert threshold
  maximum_stock    Float @default(0)   // max capacity (0 = no limit)
  reorder_quantity Float @default(0)   // suggested reorder qty

  unit_cost            Float  @default(0) // latest known cost (paise)
  last_purchase_price  Float  @default(0) // from last purchase order
  average_cost         Float  @default(0) // rolling average

  supplier         String? // vendor name (free text)
  supplier_contact String?
  supplier_lead_days Int   @default(0)

  daily_average_usage   Float @default(0)
  weeks_of_stock_remaining Float @default(0)

  is_active Boolean @default(true)

  stock_movements StockMovement[]
  purchase_orders PurchaseOrder[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id, branch_id])
  @@index([tenant_id, name])
}

// ── StockMovement ─────────────────────────────────────────────────────────────

enum MovementType {
  purchase       // received stock (PO delivered)
  order_deduct   // deducted for a completed order
  manual_add     // staff manual adjustment (positive)
  manual_remove  // staff manual adjustment (negative)
  waste          // spoilage / waste write-off
  transfer_in    // transferred from another branch
  transfer_out   // transferred to another branch
  opening        // opening stock entry
}

model StockMovement {
  id            String   @id @default(cuid())
  tenant_id     String
  branch_id     String
  ingredient_id String

  movement_type MovementType
  quantity      Float        // positive = added, negative = removed
  unit          String

  stock_before  Float
  stock_after   Float

  reference_id   String?  // order_id, purchase_order_id, etc.
  reference_type String?  // "order" | "purchase_order" | "manual" | "transfer"
  notes          String?
  created_by     String?  // user_id (null for system deductions)

  ingredient Ingredient @relation(fields: [ingredient_id], references: [id])

  created_at DateTime @default(now())

  @@index([tenant_id, branch_id, ingredient_id])
  @@index([tenant_id, branch_id, created_at])
  @@index([reference_id])
}

// ── PurchaseOrder ─────────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  draft
  sent          // sent to vendor
  confirmed     // vendor confirmed
  partial       // partially received
  received      // fully received
  cancelled
}

model PurchaseOrder {
  id        String   @id @default(cuid())
  tenant_id String
  branch_id String

  po_number  String   // PO-YYYY-XXXX
  vendor_id  String?  // ref to procurement-service Vendor (cross-service, no FK)
  vendor_name String?

  status     PurchaseOrderStatus @default(draft)

  items      Json     // Array<{ ingredient_id, ingredient_name, quantity, unit, unit_price, total_price }>
  subtotal   Float    // paise
  tax_amount Float    @default(0) // paise
  total      Float    // paise

  expected_delivery_date DateTime?
  received_at            DateTime?
  notes                  String?

  created_by String?  // user_id
  received_by String? // user_id

  ingredient    Ingredient? @relation(fields: [lead_ingredient_id], references: [id])
  lead_ingredient_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id, branch_id])
  @@index([tenant_id, status])
}

// ── DailyUsageSummary ─────────────────────────────────────────────────────────

model DailyUsageSummary {
  id            String   @id @default(cuid())
  tenant_id     String
  branch_id     String
  ingredient_id String
  date          DateTime @db.Date

  total_used    Float
  total_added   Float
  closing_stock Float

  @@unique([tenant_id, branch_id, ingredient_id, date])
  @@index([tenant_id, branch_id, date])
}
