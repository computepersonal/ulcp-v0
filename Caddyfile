# ULCP V0 gateway (local dev). Single origin so the POS and onboarding apps share login state.
# Upstreams are host ports; in Docker/Kubernetes they become service names.
:8000 {
	# --- APIs ---
	handle /api/v1/auth/* {
		reverse_proxy localhost:3001
	}
	handle /api/v1/tenants/* {
		reverse_proxy localhost:3002
	}
	handle /api/v1/onboarding/* {
		reverse_proxy localhost:3002
	}
	handle /api/v1/staff-invite/* {
		reverse_proxy localhost:3002
	}
	handle /api/v1/catalogue/* {
		reverse_proxy localhost:3003
	}
	handle /api/v1/orders/* {
		reverse_proxy localhost:3004
	}
	handle /api/v1/kots/* {
		reverse_proxy localhost:3004
	}
	# Realtime (Socket.io - WebSocket proxied automatically)
	handle /socket.io/* {
		reverse_proxy localhost:3008
	}
	handle /api/v1/realtime/* {
		reverse_proxy localhost:3008
	}

	handle /health {
		respond "ok" 200
	}

	# --- Frontends ---
	# Onboarding app: separate app, so sign-up/setup traffic never touches the POS server.
	handle /onboarding* {
		reverse_proxy localhost:5174
	}
	# Customer app (QR landing: /c/place/<slug>)
	handle /c* {
		reverse_proxy localhost:5180
	}
	# Everything else: staff POS
	handle {
		reverse_proxy localhost:5173
	}
}
