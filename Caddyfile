# ULCP V0 gateway (local dev). Single origin so the POS and onboarding apps share login state.
# Upstreams are host ports; in Docker/Kubernetes they become service names.
:8000 {
	# --- APIs ---
	@auth path /api/v1/auth /api/v1/auth/*
	handle @auth {
		reverse_proxy localhost:3001
	}
	@tenants path /api/v1/tenants /api/v1/tenants/*
	handle @tenants {
		reverse_proxy localhost:3002
	}
	@onboarding path /api/v1/onboarding /api/v1/onboarding/*
	handle @onboarding {
		reverse_proxy localhost:3002
	}
	@staff_invite path /api/v1/staff-invite /api/v1/staff-invite/*
	handle @staff_invite {
		reverse_proxy localhost:3002
	}
	@catalogue path /api/v1/catalogue /api/v1/catalogue/*
	handle @catalogue {
		reverse_proxy localhost:3003
	}
	@orders path /api/v1/orders /api/v1/orders/*
	handle @orders {
		reverse_proxy localhost:3004
	}
	@kots path /api/v1/kots /api/v1/kots/*
	handle @kots {
		reverse_proxy localhost:3004
	}
	# Realtime (Socket.io - WebSocket proxied automatically)
	handle /socket.io/* {
		reverse_proxy localhost:3008
	}
	@realtime path /api/v1/realtime /api/v1/realtime/*
	handle @realtime {
		reverse_proxy localhost:3008
	}

	handle /health {
		respond "ok" 200
	}

	# --- Frontends ---
	# Onboarding app: separate app, so sign-up/setup traffic never touches the POS server.
	handle /onboarding* {
		reverse_proxy localhost:5174
	}
	# Customer app (QR landing: /c/place/<slug>)
	handle /c* {
		reverse_proxy localhost:5180
	}
	# Everything else: staff POS
	handle {
		reverse_proxy localhost:5173
	}
}
