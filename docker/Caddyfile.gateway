# ULCP V0 gateway inside Docker / Kubernetes: one origin for UIs and APIs.
# Upstreams are service names (Docker DNS now, Kubernetes Services later).
:80 {
	encode gzip

	# One JSON access log line per request (stdout -> Loki). First place to look when a screen
	# fails: it shows what the browser asked for and what came back.
	log {
		output stdout
		format json
	}

	@auth path /api/v1/auth /api/v1/auth/*
	handle @auth {
		reverse_proxy identity-service:3001
	}
	@tenants path /api/v1/tenants /api/v1/tenants/*
	handle @tenants {
		reverse_proxy tenant-service:3002
	}
	@onboarding path /api/v1/onboarding /api/v1/onboarding/*
	handle @onboarding {
		reverse_proxy tenant-service:3002
	}
	@staff_invite path /api/v1/staff-invite /api/v1/staff-invite/*
	handle @staff_invite {
		reverse_proxy tenant-service:3002
	}
	@catalogue path /api/v1/catalogue /api/v1/catalogue/*
	handle @catalogue {
		reverse_proxy catalogue-service:3003
	}
	@orders path /api/v1/orders /api/v1/orders/*
	handle @orders {
		reverse_proxy order-service:3004
	}
	@kots path /api/v1/kots /api/v1/kots/*
	handle @kots {
		reverse_proxy order-service:3004
	}
	handle /socket.io/* {
		reverse_proxy realtime-service:3008
	}
	@realtime path /api/v1/realtime /api/v1/realtime/*
	handle @realtime {
		reverse_proxy realtime-service:3008
	}

	handle /health {
		respond "ok" 200
	}

	@onboarding_app path /onboarding /onboarding/*
	handle @onboarding_app {
		reverse_proxy onboarding:80
	}
	@customer path /c /c/*
	handle @customer {
		reverse_proxy customer:80
	}
	@kds path /kds /kds/*
	handle @kds {
		reverse_proxy kds:80
	}
	handle {
		reverse_proxy web:80
	}
}
