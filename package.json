{
  "name": "ulcp",
  "private": true,
  "scripts": {
    "dev": "turbo dev --concurrency 30",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-all.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-all.ps1 -Stop",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "save": "bash scripts/save.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.2.5",
    "tsx": "^4.21.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma"
    ]
  }
}
